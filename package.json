{
	"name": "@depthbomb/env",
	"version": "2.0.0",
	"author": "depthbomb",
	"description": "A .env validator for Bun heavily inspired by @adonisjs/env with some added validators.",
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"env",
		"dotenv",
		"bun",
		"validator",
		"config",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/env.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/env/issues"
	},
	"scripts": {
		"bench": "yarn build && node bench/env.mjs",
		"build": "tsdown",
		"check": "yarn lint && yarn typecheck && yarn test && yarn build",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix --deny-warnings",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.types.json",
		"test": "vitest --run",
		"release": "yarn check && release-it"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"oxlint": "^1.81.0",
		"release-it": "^21.0.2",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"packageManager": "yarn@4.18.0"
}
